# Nginx Configuration for Traefik-based Direct Routing (Variante 3)
# 
# This configuration implements the new hybrid routing approach where:
# 1. Nginx handles SSL termination and authentication
# 2. Nginx injects Basic Auth headers for Kasm containers
# 3. Nginx proxies traffic to Docker server's Traefik (172.22.0.28)
# 4. Traefik routes to containers based on hostname via container labels
#
# Migrated from Lua-based dynamic routing on 2026-02-01

# WebSocket upgrade headers
map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

# Server block for Kasm container subdomains
# Handles: test-desktop-*.hub.mdg-hamburg.de and test-audio-*.hub.mdg-hamburg.de
server {
    listen 443 ssl http2;
    server_name ~^(test-desktop|test-audio)-[^.]+\.hub\.mdg-hamburg\.de$;

    # SSL Configuration
    ssl_certificate      /etc/ssl/certs/hub.combined;
    ssl_certificate_key  /etc/ssl/private/hub.key;
    ssl_protocols        TLSv1.2 TLSv1.3;
    ssl_ciphers          HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    # Allow large file uploads
    client_max_body_size 100m;

    # Extended timeouts for long-running VNC/WebSocket sessions
    proxy_connect_timeout  1800;
    proxy_send_timeout     1800;
    proxy_read_timeout     1800;
    send_timeout           1800;

    keepalive_timeout      5 5;
    keepalive_requests     100;

    # Internal authentication check endpoint
    location = /auth-check-internal {
        internal;
        
        # Forward auth request to backend container access check
        proxy_pass http://172.22.0.27:5021/api/container-access-check;
        
        # Don't forward the request body
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        
        # Forward original request information
        proxy_set_header X-Original-URI $request_uri;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Host $host;
        proxy_set_header Cookie $http_cookie;
    }

    # Main location - proxy to Docker server Traefik
    location / {
        # Authenticate user via backend first
        auth_request /auth-check-internal;
        
        # Proxy to Docker server Traefik (on internal IP 172.22.0.28:80)
        proxy_pass http://172.22.0.28;
        
        # Set Basic Auth for Kasm containers
        # TODO: Consider using environment variables via nginx envsubst or similar
        # Base64 encoded: kasm_user:password (same as original Lua implementation)
        # This should match VNC_PASSWORD in backend .env
        proxy_set_header Authorization "Basic a2FzbV91c2VyOnBhc3N3b3Jk";
        
        # Forward the original hostname for Traefik routing
        proxy_set_header Host $host;
        
        # Standard proxy headers
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        
        # WebSocket support
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        
        # Disable buffering for WebSocket/VNC streams
        proxy_buffering off;
        
        # Extended timeouts for long sessions
        proxy_connect_timeout 1800s;
        proxy_send_timeout 1800s;
        proxy_read_timeout 1800s;
    }

    # Logging
    access_log /var/log/nginx/test-desktop_vnc_combined.log combined;
    error_log  /var/log/nginx/test-desktop_vnc_combined.log;
}

# Server block for main dashboard/frontend (test-desktop.hub.mdg-hamburg.de)
server {
    listen 443 ssl;
    server_name test-desktop.hub.mdg-hamburg.de;

    # SSL Configuration
    ssl_certificate      /etc/ssl/certs/hub.combined;
    ssl_certificate_key  /etc/ssl/private/hub.key;
    ssl_protocols        TLSv1.2 TLSv1.3;
    ssl_ciphers          HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    # Allow large file uploads
    client_max_body_size 100m;

    # Timeouts
    proxy_connect_timeout  1800;
    proxy_send_timeout     1800;
    proxy_read_timeout     1800;
    send_timeout           1800;

    keepalive_timeout      5 5;
    keepalive_requests     100;
    root /dev/null;

    # Main location - Frontend (React)
    location / {
        proxy_pass http://172.22.0.27:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    # API Backend Proxy
    location /api/ {
        proxy_pass   http://172.22.0.27:5021;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }

    # WebSocket Proxy for /ws
    location /ws/ {
        proxy_pass   http://172.22.0.27:5021;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }

    # Logging
    access_log /var/log/nginx/test-desktop_access.log;
    error_log  /var/log/nginx/test-desktop_error.log;
}

# Backend API URL (leave empty for same-origin)
REACT_APP_API_URL=

# WebSocket URL (leave empty for same-origin)
REACT_APP_WS_URL=

# WebRTC Configuration
# Enable WebRTC for direct connections (requires coturn server)
REACT_APP_WEBRTC_ENABLED=false
# TURN server URL
REACT_APP_TURN_SERVER_URL=turn:turn.example.com:3478
# STUN server URL
REACT_APP_STUN_SERVER_URL=stun:turn.example.com:3478

# Backend API URL (leave empty for same-origin)
VITE_API_URL=

# WebSocket URL (leave empty for same-origin)
VITE_WS_URL=

# Container subdomain prefix (e.g., 'desktop' for desktop-*.domain.com or 'test-desktop' for test-desktop-*.domain.com)
VITE_CONTAINER_PREFIX=desktop

# Enable WebRTC features
VITE_WEBRTC_ENABLED=true

# Frontend version
VITE_VERSION=1.0.0
